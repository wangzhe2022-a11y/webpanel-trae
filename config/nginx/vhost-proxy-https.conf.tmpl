# ============================================================================
# WebPanel managed vhost (Node.js reverse proxy, HTTPS) - DO NOT EDIT BY HAND
# Site user : {{USER}}
# Domain    : {{PRIMARY}}
# App port  : {{PORT}}
# ----------------------------------------------------------------------------
server {
    listen 80;
    server_name {{DOMAINS}};

    # Let's Encrypt http-01 challenge (kept out of the proxy)
    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/{{USER}}/public;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name {{DOMAINS}};

    ssl_certificate     /www/server/certs/{{PRIMARY}}/fullchain.pem;
    ssl_certificate_key /www/server/certs/{{PRIMARY}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL_{{USER}}:10m;
    ssl_session_timeout 1d;
{{HSTS}}

    access_log /www/wwwlogs/{{USER}}.log;
    error_log  /www/wwwlogs/{{USER}}.error.log;

    client_max_body_size 256m;

    location / {
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # websocket support (map defined in conf.d by the installer)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }
}
