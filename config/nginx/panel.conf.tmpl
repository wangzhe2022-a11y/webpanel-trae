# ============================================================================
# WebPanel itself - management UI on {{PORT}} (HTTPS, self-signed by default)
# Restrict source IPs here or via Tencent Cloud security group.
# ----------------------------------------------------------------------------
server {
    listen {{PORT}} ssl http2;
    server_name _;

    ssl_certificate     /www/server/certs/panel/fullchain.pem;
    ssl_certificate_key /www/server/certs/panel/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/local/webpanel/panel/public;
    index index.php;

    access_log /www/wwwlogs/panel.log;
    error_log  /www/wwwlogs/panel.error.log;

    # Restore real client IP when panel is accessed via reverse proxy (80/443).
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # IP access control — managed by the dashboard (deny list) and the installer
    # (allow list). Edit /www/server/panel/allow-ips.conf to change allowed IPs.
    include /www/server/panel/deny-ips.conf;
    include /www/server/panel/allow-ips.conf;

    client_max_body_size 1024m;

    # Large-file downloads (vdb cpmove tarballs, panel backups). See
    # config/nginx/panel-download.inc — required ops follow-up on existing CVMs.
    include /usr/local/webpanel/config/nginx/panel-download.inc;

    location / {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php-fpm/panel.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
    }

    # Built-in phpMyAdmin (session-gated). Snippet is a no-op until
    # wp-pma.sh install writes files under /www/server/phpmyadmin.
    include /usr/local/webpanel/config/nginx/phpmyadmin.inc;

    location ~ /\.(?!well-known) {
        deny all;
    }
}
