# ============================================================================
# WebPanel managed vhost (Node.js reverse proxy) - DO NOT EDIT BY HAND
# Site user : {{USER}}
# Domain    : {{PRIMARY}}
# App port  : {{PORT}}
# ----------------------------------------------------------------------------
server {
    listen 80;
    server_name {{DOMAINS}};

    access_log /www/wwwlogs/{{USER}}.log;
    error_log  /www/wwwlogs/{{USER}}.error.log;

    client_max_body_size 256m;

    # Let's Encrypt http-01 challenge (kept out of the proxy)
    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/{{USER}}/public;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # websocket support (map defined in conf.d by the installer)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
    }
}
